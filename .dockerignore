# The root Dockerfile ends with `COPY . ./` — without this file the whole
# repo lands in the runtime image: .git (full history), tests, docs, CI
# config, local venvs. None of it is needed to serve, all of it widens the
# image and its attack/leak surface. Keep this list in sync with what
# api/ + src/ + streamlit_app/ actually import at runtime.
.git
.github
.gitignore
.gitattributes
.dockerignore
.trivyignore
# Every venv, not just the two canonical names: the working venv here is
# .venv312, which the bare ".venv" entry does not match.
.venv*
venv
env/
# Secrets and local experiment state must never enter the image.
.env
.env.*
*.env
mlruns/
notebooks/
__pycache__/
*.pyc
.pytest_cache
.mypy_cache
.ruff_cache
htmlcov
tests/
docs/
deploy/
benchmarks/
reports/
data/
output/
Makefile
README.md
MODEL_CARD.md
CHANGELOG.md
SECURITY.md
CONTRIBUTING.md
DEPLOY.md
run_training.py
requirements-dev.txt
requirements-train.txt
sbom.cyclonedx.json
